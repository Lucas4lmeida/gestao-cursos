[Unit]
Description=Sistema de Gestão de Cursos (FastAPI + React) - PF Banco de Dados
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=gestao
Group=gestao
WorkingDirectory=/opt/gestao-cursos/backend
EnvironmentFile=/etc/gestao-cursos/gestao.env
ExecStart=/opt/gestao-cursos/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=3
# Só escuta em 127.0.0.1; o acesso externo passa pelo Caddy (HTTP/HTTPS)
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=300M

[Install]
WantedBy=multi-user.target
